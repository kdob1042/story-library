{
  "id": "P01-M07",
  "purpose": "三本目の成功を由美子の声と拍手で回収し、教室へつなぐ。",
  "entryBeatId": "P01-beat-13",
  "exit": {
    "kind": "pause",
    "note": "由美子が知らない一年生へ夢中で手をたたくところで場面を閉じる。",
