  "sourceExcerpts": [
    {
      "id": "P01-01:u38:a0",
      "text": "パシュッ。",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1828,
        "endCp": 1833
      }
    },
    {
      "id": "P01-01:u39:a0",
      "text": "綺麗にネットが揺れた。",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1835,
        "endCp": 1846
      }
    },
    {
      "id": "P01-01:u40:a0",
      "text": "「うまっ……！」",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1848,
        "endCp": 1856
      }
    },
    {
      "id": "P01-01:u41:a0",
      "text": "今度は自分でも驚くくらい、声が口からこぼれていた。",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1858,
        "endCp": 1883
      }
    },
    {
      "id": "P01-01:u42:a0",
      "text": "遠くの列で、真希が振り返ってこちらを見た。",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1885,
        "endCp": 1906
      }
    },
    {
      "id": "P01-01:u42:a1",
      "text": "けれど由美子はそれに気づかないまま、コートの真ん中で先輩たちとハイタッチを交わすその知らない一年生へ向けて、夢中で手をたたいていた。",
      "origin": {
        "snapshotId": "name-source:1d100bd3305f9f8fdca84e46ca407d3efe76c4c43307a637a528aa68448ca2eb",
        "sceneId": "P01-01",
        "startCp": 1906,
        "endCp": 1972
      }
    }
  ],
