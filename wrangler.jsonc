{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "story-library-reader",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/reader",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
